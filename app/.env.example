# 仅服务端环境变量；不要提交实际密钥或发送到聊天。
DASHSCOPE_API_KEY=
BAILIAN_WORKSPACE_ID=
# 仅当控制台确认 qwen3-vl-plus 免费额度用完即停已生效，才改为 true。
BAILIAN_FREE_QUOTA_CONFIRMED=false
# 可选：切换模型前，须在百炼确认该模型的免费额度及“用完即停”已生效。
YOGA_VISION_MODEL=qwen3-vl-plus
# 额外确认的模型，逗号分隔。例如 qwen3.7-plus；未确认时保持空白。
BAILIAN_FREE_QUOTA_CONFIRMED_MODELS=
# 可在网页“连接免费模型”中填写，无需手改此文件。
# YOGA_PROVIDER=zhipu
ZHIPU_API_KEY=
# 用户提供的额度平台；也可在网页“连接提供的额度”中填写。
NEXT_BASE_URL=https://api.openai-next.com/v1
NEXT_API_KEY=
NEXT_AVAILABLE_MODELS=[]
# 经确认允许测试的 HTTPS 视频直链域名，逗号分隔；默认不允许任何远程来源。
VIDEO_ALLOWED_HOSTS=
